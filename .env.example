# Valeurs fictives uniquement. Ne jamais ecraser un .env existant.
# Inutile pour scripts/local_demo.py : ce lanceur ignore le .env et cree une base jetable.
POSTGRES_USER=dreams_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
POSTGRES_DB=dreams_demo
POSTGRES_PORT=5433
# Origine HTTPS exacte du navigateur (sans chemin). Aucun secret ici.
WEB_ORIGIN=https://localhost:8443
# P12 : 0 desactive les pages Swagger/ReDoc et leurs CDN ; OpenAPI JSON reste disponible.
# Valeur conseillee hors developpement. Sans variable : 1 pour compatibilite P01.
API_DOCS_ENABLED=0
# Suggestion emotionnelle desactivee pour l'installation sans modele.
EMOTION_ENABLED=0
# P05 : le worker seul charge le modèle ; aucun téléchargement automatique.
STT_ENGINE=faster-whisper
STT_TIMEOUT_SECONDS=600
# Par défaut : %LOCALAPPDATA%/Synthetiseur/models/whisper-small
# STT_MODEL_PATH=C:/Users/YOUR_WINDOWS_USER/AppData/Local/Synthetiseur/models/whisper-small
# Optionnel : dossier absolu dédié, hors dépôt, static et OneDrive.
# Par défaut Windows : %LOCALAPPDATA%/SynthetiseurDeReves/private_media
# PRIVATE_MEDIA_ROOT=C:/Users/YOUR_WINDOWS_USER/AppData/Local/SynthetiseurDeReves/private_media
# URL SQLAlchemy ; encoder les caracteres speciaux du mot de passe dans l'URL.
DATABASE_URL=postgresql+psycopg://dreams_app:REPLACE_WITH_LOCAL_RANDOM_PASSWORD@127.0.0.1:5433/dreams_demo
# Tests : utiliser les lanceurs P14 qui generent les URL et l'autorisation temporaire.
# Ne pas renseigner TEST_DATABASE_URL vers une base personnelle ou persistante.
