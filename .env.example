# Valeurs fictives uniquement. Copier vers .env (ignore par Git) et remplacer le mot de passe.
POSTGRES_USER=dreams_local
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
POSTGRES_DB=dreams_local
POSTGRES_PORT=5433
# URL SQLAlchemy ; encoder les caracteres speciaux du mot de passe dans l'URL.
DATABASE_URL=postgresql+psycopg://dreams_local:REPLACE_WITH_LOCAL_RANDOM_PASSWORD@127.0.0.1:5433/dreams_local
# Tests : base de test locale uniquement. Ne jamais utiliser une base de production.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:REPLACE_ME@127.0.0.1:5433/test_database
